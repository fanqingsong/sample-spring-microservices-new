type Query {
  departments: [Department]
  department(id: ID!): Department
  departmentsByOrganization(organizationId: ID!): [Department]
  departmentsByOrganizationWithEmployees(organizationId: ID!): [Department]
}

type Department {
  id: ID
  organizationId: ID
  name: String
  employees: [Employee]
}

type Employee {
  id: ID
  organizationId: ID
  departmentId: ID
  name: String
  age: Int
  position: String
}
